APP_NAME="App Deployer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Rendu côté serveur Inertia (SEO/crawlers) : nécessite que le worker Node
# soit démarré (`php artisan inertia:start-ssr`) et le bundle SSR construit
# (`npm run build` construit désormais aussi le bundle SSR). Se dégrade
# silencieusement en rendu client si le serveur SSR est injoignable.
# INERTIA_SSR_URL est côté PHP (où Laravel envoie les requêtes de rendu) ;
# INERTIA_SSR_PORT est côté Node (le port sur lequel `ssr.js` écoute réellement,
# lu depuis `process.env` dans resources/js/ssr.tsx). Les deux doivent pointer
# vers le même port — changez les deux ensemble si vous en avez besoin d'un autre
# (ex: plusieurs apps Inertia sur le même serveur).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_PORT=13714

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production runs PostgreSQL — keep local/dev on pgsql too to avoid
# MySQL-only SQL slipping into migrations again (see git history for the
# ALTER TABLE ... MODIFY incident).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app_deployers_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
DEPLOY_QUEUE=deploy

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notifications@app-deployer.dev"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="contact@app-deployer.dev"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
