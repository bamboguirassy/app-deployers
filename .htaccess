<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laisse passer les requêtes qui ciblent déjà /public/... (ex: liens
    # absolus vers /public/build/... générés par certains outils) sans
    # boucler dessus.
    RewriteCond %{REQUEST_URI} ^/public/
    RewriteRule ^(.*)$ - [L]

    # Sert directement les fichiers/dossiers réels situés dans public/
    # (assets buildés, storage/ symlinké, favicon, etc.) sans passer par index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Tout le reste est routé vers le front controller de Laravel.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
